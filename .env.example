# deepseek-proxy 环境变量配置
# 复制此文件为 .env 并填入真实密钥

# 代理认证密钥（客户端请求时用）
DP_PROXY_API_KEY=sk-dp-your-key-here

# DeepSeek API 密钥
DP_DEEPSEEK_API_KEY=sk-your-deepseek-key

# Vision 插件 — 图片识别（OpenAI 兼容接口）
DP_VISION_BASE_URL=https://api.openai.com/v1
DP_VISION_MODEL=gpt-4o
DP_VISION_API_KEY=sk-your-openai-key

# 搜索插件 — Tavily API 密钥
DP_SEARCH_API_KEY=tvly-your-tavily-key
