# deepseek-proxy 环境变量配置
# 复制此文件为 .env 并填入真实密钥

# 代理认证密钥（客户端请求时用）
DP_PROXY_API_KEY=sk-dp-your-key-here

# DeepSeek API 密钥
DP_DEEPSEEK_API_KEY=sk-your-deepseek-key

# Vision 插件 — 选择 providers 中某个视觉模型，设置对应 API Key
# 格式: DP_VISION_<NAME>_API_KEY
# 例如用阿里百炼: DP_VISION_BAILIAN_API_KEY=sk-xxx
# 例如用火山引擎: DP_VISION_VOLCENGINE_API_KEY=sk-xxx
DP_VISION_OPENAI_API_KEY=sk-your-openai-key

# 搜索插件 — Tavily API 密钥
DP_SEARCH_API_KEY=tvly-your-tavily-key
