# deepseek-proxy 环境变量配置
# 复制此文件为 .env 并填入真实密钥

# 代理认证密钥（客户端请求时用）
DP_PROXY_API_KEY=sk-dp-your-key-here

# DeepSeek API
DP_DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic
DP_DEEPSEEK_API_KEY=sk-your-deepseek-key

# Vision 插件 — 图片识别（OpenAI 兼容接口）
# DP_VISION_ENABLED=true   # 取消注释启用
# 各厂商 OpenAI 兼容接口示例:
#   阿里百炼: DP_VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  DP_VISION_MODEL=qwen-vl-max
#   火山引擎: DP_VISION_BASE_URL=https://ark.cn-beijing.volces.com/api/v3             DP_VISION_MODEL=doubao-vision-pro-32k
#   硅基流动: DP_VISION_BASE_URL=https://api.siliconflow.cn/v1                       DP_VISION_MODEL=Qwen/Qwen2.5-VL-72B-Instruct
#   MiniMax:  DP_VISION_BASE_URL=https://api.minimax.chat/v1                         DP_VISION_MODEL=abab7-chat
#   智谱 GLM: DP_VISION_BASE_URL=https://open.bigmodel.cn/api/paas/v4                DP_VISION_MODEL=glm-4v
#   Moonshot: DP_VISION_BASE_URL=https://api.moonshot.cn/v1                          DP_VISION_MODEL=moonshot-v1-8k-vision
DP_VISION_BASE_URL=https://api.openai.com/v1
DP_VISION_MODEL=gpt-4o
DP_VISION_API_KEY=sk-your-openai-key
# thinking 模型（Qwen/DeepSeek 等）需设置推理 token 上限，防止推理吃光 max_tokens:
# DP_VISION_THINKING_BUDGET=1638

# 搜索插件 — 服务端搜索（Tavily / Bocha / Brave）
# DP_SEARCH_ENABLED=true   # 取消注释启用
# 在 config/default.yaml 中 plugins.search.provider 选择提供商
DP_SEARCH_API_KEY=tvly-your-tavily-key
